WITH sample_data AS (
  SELECT TIMESTAMP '2024-08-01 10:00:00' AS Timestamp UNION ALL
  SELECT TIMESTAMP '2024-08-02 12:00:00' UNION ALL
  SELECT TIMESTAMP '2024-08-04 15:00:00' UNION ALL
  SELECT TIMESTAMP '2024-08-10 08:30:00' UNION ALL
  SELECT TIMESTAMP '2024-08-11 09:15:00' UNION ALL
  SELECT TIMESTAMP '2024-08-14 17:45:00' UNION ALL
  SELECT TIMESTAMP '2024-08-16 19:30:00' UNION ALL
  SELECT TIMESTAMP '2024-08-18 20:00:00' UNION ALL
  SELECT TIMESTAMP '2024-08-22 07:45:00' UNION ALL
  SELECT TIMESTAMP '2024-08-23 06:00:00' UNION ALL
  SELECT TIMESTAMP '2024-08-24 10:15:00' UNION ALL
  SELECT TIMESTAMP '2024-08-30 14:20:00'
),
ranked_data AS (
  SELECT 
    Timestamp,
    TIMESTAMP_TRUNC(Timestamp, DAY) AS event_date,
    LAG(TIMESTAMP_TRUNC(Timestamp, DAY)) OVER (ORDER BY TIMESTAMP_TRUNC(Timestamp, DAY)) AS prev_date
  FROM sample_data
),
grouped_data AS (
  SELECT 
    *,
    SUM(CASE 
          WHEN prev_date IS NULL OR DATE_DIFF(event_date, prev_date, DAY) > 1 THEN 1 
          ELSE 0 
        END) OVER (ORDER BY event_date) AS group_id
  FROM ranked_data
)
SELECT * FROM grouped_data
ORDER BY event_date;